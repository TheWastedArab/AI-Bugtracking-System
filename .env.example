# Use independent randomly generated secrets. URL-encode special characters in the database password.
POSTGRES_PASSWORD=replace-with-random-alphanumeric-password
JWT_SECRET=replace-with-at-least-32-random-characters
DOMAIN=localhost
# Local Python processes read environment variables, not this file automatically.
# Docker Compose reads .env. SMTP requires an explicit compose override to MAIL_TRANSPORT.
MAIL_TRANSPORT=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
NTFY_URL=
NTFY_TOKEN=
